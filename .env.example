# mock (default) | live
A2K_BOX_MODE=mock

# Cala (https://docs.cala.ai) -- API key auth
CALA_API_KEY=
CALA_BASE_URL=https://api.cala.ai
# How long to trust a cached /introspection result (which fields *exist* for
# an entity -- schema, not values) before re-fetching it. Cuts Cala API calls
# roughly in half on repeated lookups of the same company without affecting
# data freshness, since property *values* are always fetched fresh regardless.
CALA_INTROSPECTION_CACHE_TTL_SECONDS=86400

# Cala's own hosted MCP server (adapters/cala_mcp.py), used by K2/AgentCore
# instead of the REST adapter above when that transport is selected -- same
# CALA_API_KEY, same account.
CALA_MCP_URL=https://api.cala.ai/mcp/
# entity_first (default) -- precise field-level lookups, knowledge_search
#   only as a last resort | parallel -- always run both, merge results |
#   knowledge_search_only -- skip straight to Cala's own synthesized answer.
# See adapters/cala_mcp.py's module docstring for the grounding trade-off.
CALA_SEARCH_MODE=entity_first

# Sayari (https://documentation.sayari.com) -- OAuth2 client-credentials
SAYARI_CLIENT_ID=
SAYARI_CLIENT_SECRET=
SAYARI_BASE_URL=https://api.sayari.com

# Sayari's own hosted MCP server (adapters/sayari_mcp.py). Auth0
# client-credentials -- a SEPARATE credential/grant from SAYARI_CLIENT_ID
# above; REST-scoped credentials are rejected on the MCP audience (confirmed
# live 2026-08-12, see adapters/sayari_mcp.py's module docstring).
SAYARI_MCP_URL=https://mcp.sayari.com/mcp
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# How many name-match candidates from Cala/Sayari's entity search get fully
# hydrated (full field retrieval / entity summary) per a2k.ask or a2k.search
# call -- NOT the same as the search's own result limit, which only controls
# how many candidates are considered. Confirmed live 2026-08-18: leaving this
# uncapped (effectively = the search limit, up to 50 for a2k.ask) meant a
# single ambiguous query could hydrate dozens of unrelated entities, ~458KB/
# ~114K tokens of Facts for one call -- enough on its own to blow Bedrock's
# per-request byte limit. See adapters/cala_mcp.py and adapters/sayari_mcp.py.
A2K_MAX_ENTITIES_TO_HYDRATE=3

# Audit trail (KCP section 11) -- append-only JSONL, plus a stdout copy for
# cluster log aggregation (recommended in Kubernetes). Immutable/WORM audit
# is a Level 3+/S2 concept (see README "Conformance") -- this gateway
# targets Level 2 with public/S0 data, so it defaults to off.
A2K_AUDIT_LOG_PATH=./audit.jsonl
A2K_IMMUTABLE_AUDIT=false
A2K_AUDIT_STDOUT=true

# REST transport
A2K_BOX_HOST=0.0.0.0
A2K_BOX_PORT=8080
A2K_BOX_PUBLIC_URL=http://localhost:8080
